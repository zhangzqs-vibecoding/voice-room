LIVEKIT_URL=ws://localhost:7880
# 浏览器实际可访问的 LiveKit 地址；容器内部 LIVEKIT_URL 不能返回给浏览器。
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
LIVEKIT_TOKEN_TTL_SECONDS=900
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_KEYS=10000
MAX_KNOWN_ROOMS=10000
ROOM_SWEEP_TIMEOUT_MS=100
# 必须为 1000ms 的正整数倍，以匹配 LiveKit SDK 的秒级请求超时。
LIVEKIT_REQUEST_TIMEOUT_MS=1000
# 仅信任这些反向代理的 X-Forwarded-For；本地开发保持为空。
TRUSTED_PROXY_CIDRS=
PORT=3000
